{% extends 'layout.html.twig' %}
{% block title %}Administration · Operational Status{% endblock %}
{% block content %}
<section class="admin-heading"><div><p class="eyebrow">Operations control</p><h1>Status administration</h1></div><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="{{ csrf_token('logout') }}"><button class="secondary">Sign out</button></form></section>
{% if flash %}<div class="alert">{{ flash }}</div>{% endif %}
<section class="stats"><article><strong>{{ allComponents|length }}</strong><span>Components</span></article><article><strong>{{ incidents|length }}</strong><span>Active incidents</span></article><article><strong>{{ maintenance|length }}</strong><span>Maintenance windows</span></article><article><strong>{{ overall.label }}</strong><span>Overall state</span></article></section>

<section class="grid two">
  <div class="panel"><p class="eyebrow">Catalog</p><h2>Create group</h2><form method="post" action="/admin/groups" class="stack"><input type="hidden" name="_csrf" value="{{ csrf_token('admin_write') }}"><label>Name<input name="name" required maxlength="120"></label><label>Description<textarea name="description" maxlength="500"></textarea></label><button>Create group</button></form></div>
  <div class="panel"><p class="eyebrow">Catalog</p><h2>Create component</h2><form method="post" action="/admin/components" class="stack"><input type="hidden" name="_csrf" value="{{ csrf_token('admin_write') }}"><label>Name<input name="name" required maxlength="120"></label><label>Group<select name="group_id"><option value="">Ungrouped</option>{% for group in allGroups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></label><label>Description<textarea name="description" maxlength="500"></textarea></label><label class="check"><input type="checkbox" name="is_internal" value="1"> Internal component</label><button>Create component</button></form></div>
</section>

<section class="panel"><p class="eyebrow">Incident management</p><h2>Publish incident</h2><form method="post" action="/admin/incidents" class="form-grid"><input type="hidden" name="_csrf" value="{{ csrf_token('admin_write') }}"><label>Title<input name="title" required maxlength="180"></label><label>Severity<select name="severity">{% for severity in severityValues %}<option value="{{ severity.value }}">{{ severity.value|title }}</option>{% endfor %}</select></label><label class="full">Description<textarea name="description" required rows="3"></textarea></label><fieldset class="full"><legend>Affected components</legend>{% for component in allComponents %}<label class="check"><input type="checkbox" name="component_ids[]" value="{{ component.id }}"> {{ component.name }}{% if component.is_internal %} (internal){% endif %}</label>{% endfor %}</fieldset><button>Publish incident</button></form></section>

<section class="panel"><p class="eyebrow">Immutable timeline</p><h2>Active incidents</h2>{% for incident in incidents %}<article class="admin-incident"><div><h3>{{ incident.title }}</h3><span class="badge">{{ incident.status }}</span></div><form method="post" action="/admin/incidents/{{ incident.id }}/updates" class="form-grid"><input type="hidden" name="_csrf" value="{{ csrf_token('admin_write') }}"><input type="hidden" name="lock_version" value="{{ incident.lock_version }}"><label>Next status<select name="status">{% for status in incidentStatuses %}{% if status.value != incident.status %}<option value="{{ status.value }}">{{ status.value|replace({'_':' '})|title }}</option>{% endif %}{% endfor %}</select></label><label class="full">Update<textarea name="message" required></textarea></label><button>Publish update</button></form></article>{% else %}<p class="empty">No active incidents.</p>{% endfor %}</section>

<section class="panel"><p class="eyebrow">Change calendar</p><h2>Schedule maintenance</h2><form method="post" action="/admin/maintenance" class="form-grid"><input type="hidden" name="_csrf" value="{{ csrf_token('admin_write') }}"><label>Title<input name="title" required maxlength="180"></label><label>Starts<input type="datetime-local" name="starts_at" required></label><label>Ends<input type="datetime-local" name="ends_at" required></label><label class="full">Description<textarea name="description" required></textarea></label><fieldset class="full"><legend>Affected components</legend>{% for component in allComponents %}<label class="check"><input type="checkbox" name="component_ids[]" value="{{ component.id }}"> {{ component.name }}</label>{% endfor %}</fieldset><button>Schedule maintenance</button></form></section>

<section class="panel"><p class="eyebrow">Evidence</p><h2>Audit log</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Action</th><th>Aggregate</th><th>Actor</th></tr></thead><tbody>{% for event in audit %}<tr><td>{{ event.created_at|date('M j H:i:s') }}</td><td><code>{{ event.action }}</code></td><td>{{ event.aggregate_type }} {{ event.aggregate_id|default('') }}</td><td>{{ event.actor }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
